{
  "name": "itc-tasks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.mjs",
    "worker:dev": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.mjs --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "import:build": "esbuild scripts/import-windshift.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/import-windshift.mjs --external:pg-native --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth/api-key": "1.7.25",
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@node-rs/argon2": "2.2.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@tanstack/react-table": "9.3.1",
    "@tiptap/extension-mention": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "better-auth": "1.7.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "fractional-indexing": "4.0.0",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-security": "4.2.1",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  }
}

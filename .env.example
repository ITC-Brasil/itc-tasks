# Banco (docker-compose.dev.yml publica o Postgres em 5435)
DATABASE_URL=postgres://itc:itc@localhost:5435/itc_tasks
DATABASE_URL_TEST=postgres://itc:itc@localhost:5435/itc_tasks_test

# Better Auth — gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Primeiro admin: npm run db:seed (idempotente; senha com 12+ caracteres)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# opcional; padrão "Administrador" (iniciais calculadas pelo nome)
SEED_ADMIN_NAME=

GLPI_BASE_URL=http://glpi.grupoitcbrasil.com.br:8888
APP_TIMEZONE=America/Sao_Paulo
UPLOADS_DIR=./data/uploads

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tasks@itcbr.xyz

# E-mail — desenvolvimento no Mailpit (http://localhost:8025)
# Produção: smtp.titan.email / 465 / true, caixa tasks@itcbr.xyz (ADR-026)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ITC Tasks <tasks@itcbr.xyz>"
